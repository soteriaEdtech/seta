# Template only — copy to `.env.local` (and `.env` for the Prisma CLI) and fill
# in real values. NEVER put real secrets in this file; it's a committed template.

# ── App ──────────────────────────────────────────────────────────────
# Public base URL of the site (used for Paystack callback + email links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Postgres via Prisma ORM) ───────────────────────────────
# Default is Prisma Postgres (`npx create-db`), but any Postgres URL works.
# The Prisma CLI reads `.env`; Next reads `.env.local` — keep this identical
# in both files.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ── Paystack ─────────────────────────────────────────────────────────
# From your Paystack dashboard → Settings → API Keys & Webhooks.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
# Set your webhook URL there to: <NEXT_PUBLIC_APP_URL>/api/paystack/webhook

# ── Email (SMTP via nodemailer) ──────────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false            # true for port 465
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="SETA Program <no-reply@soterialearning.com>"
# Where new-application notifications are sent.
ADMIN_EMAIL=seta@soterialearning.com

# ── Admin dashboard ──────────────────────────────────────────────────
# Admin logins live in the `admins` table (hashed passwords). These values
# seed / reset the first admin row via `npm run db:seed`.
ADMIN_EMAIL=seta@soterialearning.com
ADMIN_PASSWORD=change-this-strong-password
ADMIN_NAME="SETA Admin"
# Signs the admin session cookie. Any long random string; rotating it
# invalidates all existing admin sessions.
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret
